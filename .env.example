# Copy to .env. .env is in .gitignore: never commit it.

# The key the bot's store is encrypted with: 32 random bytes, base64url.
# On your computer, keep it in its own file, readable only by you:
#   npx @peachysocial/bot keygen --out .peachy-store-key
# and point at it here. Keep a copy somewhere safe too.
PEACHY_BOT_STORE_KEY_FILE=.peachy-store-key
# In production, set the key itself from your host's secrets instead:
# PEACHY_BOT_STORE_KEY=

# Your Anthropic API key, from the Claude Console. Every question is billed to it.
ANTHROPIC_API_KEY=

# Optional: the model (default claude-opus-5-5) and effort (default low).
CLAUDE_MODEL=
CLAUDE_EFFORT=

# Optional: questions per chat per window, "<questions>/<minutes>" (default
# 10/10), or "off". The bot's DM with each person counts as its own chat.
CLAUDE_RATE_LIMIT=

# Optional: who may reach the bot, comma-separated: account ids, or handles.
# This narrows the listing's "Who can use it"; empty leaves it to the
# listing. Prefer ids: a handle is looked up again after every start, so one
# that changed hands would let its new holder in. The bot logs each handle's
# id (an `allow.resolved` line); put that id here instead.
PEACHY_BOT_ALLOW=

# Optional: where the SQLite store lives (default ./data/bot.db).
# Ignored when DATABASE_URL is set.
PEACHY_BOT_DB=

# Optional, for hosts where you can't run `npx @peachysocial/bot connect`: the
# one-time Connect code. Used only while the store holds no bot; remove it after.
PEACHY_CONNECT_CODE=
